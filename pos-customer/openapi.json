{
    "openapi": "3.1.0",
    "info": {
        "title": "Positivity Customer API",
        "description": "API documentation for the Customer service, accessible via the API Gateway. Provides CRM functionality including customer management, party relationships, accounts, contacts, preferences, vehicles, and snapshots.",
        "contact": {
            "name": "Durion Team",
            "email": "louis.burroughs@gmail.com"
        },
        "version": "v1"
    },
    "servers": [
        {
            "url": "http://api-gateway.local/api/customer",
            "description": "API Gateway"
        }
    ],
    "tags": [
        {
            "name": "Customer API",
            "description": "Basic customer CRUD operations"
        },
        {
            "name": "CRM Accounts",
            "description": "Account tier management, party creation, search, merge, contacts, preferences, and vehicle operations"
        },
        {
            "name": "CRM Persons",
            "description": "Individual person management APIs"
        },
        {
            "name": "CRM Party Relationships",
            "description": "Commercial account relationship management APIs"
        },
        {
            "name": "CRM Contacts",
            "description": "Contact point and role management for parties"
        },
        {
            "name": "CRM Communication Preferences",
            "description": "Communication preferences and consent flag management"
        },
        {
            "name": "CRM Vehicles",
            "description": "Vehicle management operations for customers"
        },
        {
            "name": "CRM Snapshots",
            "description": "Consolidated CRM data snapshots"
        }
    ],
    "paths": {
        "/v1/crm": {
            "get": {
                "tags": [
                    "Customer API"
                ],
                "summary": "Get all customers",
                "description": "Retrieve a paginated list of customers by type (PERSON or COMMERCIAL). Defaults to PERSON customers if no type specified.",
                "operationId": "getAllCustomers",
                "parameters": [
                    {
                        "name": "customerType",
                        "in": "query",
                        "description": "Customer type filter: PERSON or COMMERCIAL",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "PERSON",
                            "enum": [
                                "PERSON",
                                "COMMERCIAL"
                            ]
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page index (0-based)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 0
                        }
                    },
                    {
                        "name": "size",
                        "in": "query",
                        "description": "Page size",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 20
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Page of customers returned successfully"
                    },
                    "403": {
                        "description": "Forbidden"
                    }
                },
                "security": [
                    {
                        "bearerAuth": [
                            "crm:party:view"
                        ]
                    }
                ]
            },
            "post": {
                "tags": [
                    "Customer API"
                ],
                "summary": "Create a new customer",
                "operationId": "createCustomer",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CustomerDTO"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Customer created successfully"
                    },
                    "400": {
                        "description": "Invalid request"
                    }
                },
                "security": [
                    {
                        "bearerAuth": [
                            "crm:party:create"
                        ]
                    }
                ]
            }
        },
        "/v1/crm/{id}": {
            "get": {
                "tags": [
                    "Customer API"
                ],
                "summary": "Get customer by ID",
                "operationId": "getCustomerById",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Customer found"
                    },
                    "404": {
                        "description": "Customer not found"
                    }
                },
                "security": [
                    {
                        "bearerAuth": [
                            "crm:party:view"
                        ]
                    }
                ]
            },
            "put": {
                "tags": [
                    "Customer API"
                ],
                "summary": "Update an existing customer",
                "operationId": "updateCustomer",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CustomerDTO"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Customer updated"
                    },
                    "404": {
                        "description": "Customer not found"
                    }
                },
                "security": [
                    {
                        "bearerAuth": [
                            "crm:party:edit"
                        ]
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Customer API"
                ],
                "summary": "Delete a customer",
                "operationId": "deleteCustomer",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Customer deleted"
                    },
                    "404": {
                        "description": "Customer not found"
                    }
                },
                "security": [
                    {
                        "bearerAuth": [
                            "crm:party:deactivate"
                        ]
                    }
                ]
            }
        },
        "/v1/crm/snapshot/party/{partyId}": {
            "get": {
                "tags": [
                    "CRM Snapshots"
                ],
                "summary": "Fetch snapshot by party",
                "description": "Returns complete party snapshot with accounts, contacts, vehicles",
                "operationId": "fetchByParty",
                "parameters": [
                    {
                        "name": "partyId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    },
                    "404": {
                        "description": "Party not found"
                    }
                },
                "security": [
                    {
                        "bearerAuth": [
                            "crm:party:view"
                        ]
                    }
                ]
            }
        },
        "/v1/crm/snapshot/vehicle/{vehicleId}": {
            "get": {
                "tags": [
                    "CRM Snapshots"
                ],
                "summary": "Fetch snapshot by vehicle",
                "description": "Returns party snapshot based on vehicle ownership",
                "operationId": "fetchByVehicle",
                "parameters": [
                    {
                        "name": "vehicleId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    },
                    "404": {
                        "description": "Vehicle or owner not found"
                    }
                },
                "security": [
                    {
                        "bearerAuth": [
                            "crm:party:view"
                        ]
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "CustomerDTO": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "phoneNumber": {
                        "type": "string"
                    }
                }
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}