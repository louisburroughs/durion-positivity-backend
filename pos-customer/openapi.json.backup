{
    "openapi": "3.1.0",
    "info": {
        "title": "Positivity Customer API",
        "description": "API documentation for the Customer service, accessible via the API Gateway.",
        "contact": {
            "name": "Durion Team",
            "email": "louis.burroughs@gmail.com"
        },
        "version": "v1"
    },
    "servers": [
        {
            "url": "http://api-gateway.local/api/customer",
            "description": "API Gateway"
        }
    ],
    "tags": [
        {
            "name": "CRM Vehicles",
            "description": "Vehicle management operations for customers (stub endpoints)"
        },
        {
            "name": "Customer API",
            "description": "Operations related to customers"
        },
        {
            "name": "CRM Contacts",
            "description": "Contact point and role management for parties (stub endpoints)"
        },
        {
            "name": "CRM Communication Preferences",
            "description": "Communication preferences and consent flag management (stub endpoints)"
        },
        {
            "name": "CRM Accounts",
            "description": "Account tier management, party creation, search, merge, contacts, preferences, and vehicle operations"
        }
    ],
    "paths": {
        "/v1/crm/{id}": {
            "get": {
                "tags": [
                    "Customer API"
                ],
                "summary": "Get customer by ID",
                "description": "Retrieve a customer by their unique ID.",
                "operationId": "getCustomerById",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID of the customer to retrieve",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        },
                        "example": 1
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Customer found and returned.",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/AbstractCustomer"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Customer not found.",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/AbstractCustomer"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Customer API"
                ],
                "summary": "Update an existing customer",
                "description": "Update the details of an existing customer.",
                "operationId": "updateCustomer",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID of the customer to update",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        },
                        "example": 1
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AbstractCustomer"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Customer updated successfully.",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/AbstractCustomer"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Customer not found.",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/AbstractCustomer"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Customer API"
                ],
                "summary": "Delete a customer",
                "description": "Delete a customer by their unique ID.",
                "operationId": "deleteCustomer",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID of the customer to delete",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        },
                        "example": 1
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Customer deleted successfully."
                    },
                    "404": {
                        "description": "Customer not found."
                    }
                }
            }
        },
