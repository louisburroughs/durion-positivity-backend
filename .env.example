# Environment Variables Configuration
# Copy this file to .env and fill in actual values (NEVER commit .env to git)
# This file shows the required variables with placeholder values

# Database Configuration
POSTGRES_USER=positivity
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=positivity
SPRING_DATASOURCE_USERNAME=pos_user
SPRING_DATASOURCE_PASSWORD=your_secure_password_here
DB_PASSWORD=your_secure_password_here

# SSL/TLS Configuration
SSL_KEYSTORE_PASSWORD=your_keystore_password_here
KEYSTORE_PASSWORD=your_keystore_password_here

# Eureka Service Discovery
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/

# Optional: API Gateway Configuration
API_GATEWAY_BASE_URL=http://localhost:8080

# Optional: Observability
# Traces/logs only — app metrics are pull-only via /actuator/prometheus (#867);
# docker-compose sets OTEL_METRICS_EXPORTER=none per service.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_VERSION=0.1.0-SNAPSHOT
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_secure_grafana_password_here

# Optional: Security Service
SECURITY_JWT_SECRET=your_jwt_secret_key_here
SECURITY_JWT_EXPIRATION=3600000
SECURITY_SEED_ADMIN_PASSWORD_HASH='$2a$12$replace_with_real_hash'

# Spring Security User (for services like pos-order)
SPRING_SECURITY_USER_NAME=admin
SPRING_SECURITY_USER_PASSWORD=your_secure_admin_password_here

# Optional: OAuth2 / OIDC
OAUTH2_CLIENT_ID=your_client_id_here
OAUTH2_CLIENT_SECRET=your_client_secret_here
OAUTH2_PROVIDER_URI=https://your-oauth-provider.com

# Spring runtime profile (dev=local, alpha=EC2, prod=production)
SPRING_PROFILES_ACTIVE=dev

# Frontend (pos-frontend) — Angular SSR allowed hosts
# Comma-separated list of hostnames the SSR server will accept.
# Must match the hosts used to reach the application (domain, IP, localhost).
NG_ALLOWED_HOSTS=durionpos.org,www.durionpos.org,34.202.151.97,localhost

# Origin pos-mcp-server uses to fetch the frontend /sitemap.json artifact (#1128).
# This is the Angular SSR server, NOT the API gateway. The SSR server listens on
# port 4000 inside its container (docker-compose publishes it on the host as 4200 —
# do not use the published port here, it is unreachable from the compose network).
# Under docker-compose, address the frontend by its service alias; leave the value
# as http://localhost:4000 only when the SSR server runs on the same host as the
# MCP server (plain local dev). If unset, ScreenLinkResolver warm-up fails and deep
# links are silently unavailable.
FRONTEND_BASE_URL=http://pos-frontend:4000

POS_EVENTS_API_SECRET=your-secure-secret-here
POS_SECURITY_API_SECRET=your-secure-secret-here

# Ollama models. Chat + fallback default to CLOUD tags served by
# OLLAMA_CHAT_BASE_URL=https://ollama.com (require OLLAMA_API_KEY) — do NOT
# `ollama pull` these locally. The embedding model runs on the local Ollama
# container (OLLAMA_EMBEDDING_BASE_URL, default http://ollama:11434).
OLLAMA_CHAT_MODEL=deepseek-v4-flash:0731
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_FALLBACK_MODEL=deepseek-v4-pro:0813

# Chat context window, sent to Ollama as num_ctx (#1683). application.yml already defaults this to
# 32768 for every profile, so leaving the line out entirely is fine -- you do NOT fall back to the
# backend's own window by omitting it. Set it only to override. Raise it if you add prompt layers,
# tool schemas, or RAG snippets; lower it to fit a backend that will not honour 32768.
#
# Do NOT write `OLLAMA_NUM_CTX=` (set but empty). Spring applies a ${VAR:default} only when the
# variable is ABSENT, not when it is empty, so an empty value reaches `int numCtx` as "" and the
# service fails to start. Same for OLLAMA_CHAT_TEMPERATURE into `double`. docker-compose masks
# this locally with `:-`; a systemd/ECS/k8s unit does not. Delete the line instead of blanking it.
OLLAMA_NUM_CTX=32768
# 0 = deterministic. The analytics gate is graded at n=1; sampling only adds run-to-run variance.
OLLAMA_CHAT_TEMPERATURE=0.0

# Gate 4 tiered model router (#1683). Dormant: with MCP_MODEL_SIMPLE blank, T2-simple and
# T2-complex are the same model, so enabling this only pays for a classification call whose
# outcome cannot change which model answers. Set MCP_MODEL_SIMPLE to a model that is measurably
# faster and cheaper than OLLAMA_CHAT_MODEL first, then set this to true. (gpt-oss:20b qualified
# next to gpt-oss:120b; next to deepseek-v4-flash:0731 it is the slower model, #1691.)
MCP_MODEL_TIERING_ENABLED=false
# Both tier models are read (docker-compose passes each through); blank = the default executor.
# Leave these commented out rather than blank -- a blank value is what makes the router a no-op.
# MCP_MODEL_SIMPLE=gpt-oss:20b
# MCP_MODEL_COMPLEX=

# Optional: MCP server web search
EXA_API_KEY=

# ── pos-supplier exchange-audit payload encryption (ADR-0050 §7) ────────────────────────
# REQUIRED. pos-supplier refuses to start without this unless the dev or test profile is
# active. Starting without it would mint a random key per JVM and make every stored payload
# permanently unreadable on the next restart -- reported afterwards as an authentication
# failure, i.e. as possible tampering, for data the deployment destroyed itself.
# Generate with:  openssl rand -base64 32
SUPPLIER_AUDIT_ENC_KEY=
# Recorded in every envelope so keys can be rotated. Leave as k1 unless rotating.
SUPPLIER_AUDIT_ENC_KEY_ID=k1
# Retired decrypt-only keys, keyId:base64 comma-separated. A key dropped from here before its
# payloads age out of the 400-day retention window takes them with it.
SUPPLIER_AUDIT_ENC_PREVIOUS_KEYS=
