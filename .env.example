# Environment Variables Configuration
# Copy this file to .env and fill in actual values (NEVER commit .env to git)
# This file shows the required variables with placeholder values

# Database Configuration
POSTGRES_USER=positivity
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=positivity
SPRING_DATASOURCE_USERNAME=pos_user
SPRING_DATASOURCE_PASSWORD=your_secure_password_here
# Password for the shared non-owner application role created by postgres/init-tenancy.sh (ADR-0062).
# Defaults to POSTGRES_PASSWORD when unset. Modules that have adopted pos-tenancy-common (pos-location)
# connect as it; the rest switch in their plan WS3 wave. Flyway keeps the POSTGRES_USER owner credential.
POS_APP_PASSWORD=
DB_PASSWORD=your_secure_password_here

# SSL/TLS Configuration
SSL_KEYSTORE_PASSWORD=your_keystore_password_here
KEYSTORE_PASSWORD=your_keystore_password_here

# Eureka Service Discovery
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/

# Optional: API Gateway Configuration
API_GATEWAY_BASE_URL=http://localhost:8080

# Optional: Observability
# Traces/logs only — app metrics are pull-only via /actuator/prometheus (#867);
# docker-compose sets OTEL_METRICS_EXPORTER=none per service.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_VERSION=0.1.0-SNAPSHOT
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_secure_grafana_password_here

# Optional: Security Service
SECURITY_JWT_SECRET=your_jwt_secret_key_here
SECURITY_JWT_EXPIRATION=3600000
SECURITY_SEED_ADMIN_PASSWORD_HASH='$2a$12$replace_with_real_hash'

# Bcrypt hash of the shared starter password that accounts loaded from the alpha fixture packs
# (scripts/fixtures/seed/alpha/security/users.csv) are created with. Optional: leave it unset and
# those accounts hold a password nobody knows, openable only with an operator-minted activation
# token. The starter password never authenticates - the accounts are created with their
# credentials expired, so POST /v1/auth/login refuses them until POST /v1/auth/activate-starter
# has traded it for a password of the account's own.
SECURITY_STARTER_PASSWORD_HASH=''

# Spring Security User (for services like pos-order)
SPRING_SECURITY_USER_NAME=admin
SPRING_SECURITY_USER_PASSWORD=your_secure_admin_password_here

# Optional: OAuth2 / OIDC
OAUTH2_CLIENT_ID=your_client_id_here
OAUTH2_CLIENT_SECRET=your_client_secret_here
OAUTH2_PROVIDER_URI=https://your-oauth-provider.com

# Spring runtime profile (dev=local, alpha=EC2, prod=production)
SPRING_PROFILES_ACTIVE=dev

# Frontend (pos-frontend) — Angular SSR allowed hosts
# Comma-separated list of hostnames the SSR server will accept.
# Must match the hosts used to reach the application (domain, IP, localhost).
NG_ALLOWED_HOSTS=durionpos.org,www.durionpos.org,34.202.151.97,localhost

# Origin pos-mcp-server uses to fetch the frontend /sitemap.json artifact (#1128).
# This is the Angular SSR server, NOT the API gateway. The SSR server listens on
# port 4000 inside its container (docker-compose publishes it on the host as 4200 —
# do not use the published port here, it is unreachable from the compose network).
# Under docker-compose, address the frontend by its service alias; leave the value
# as http://localhost:4000 only when the SSR server runs on the same host as the
# MCP server (plain local dev). If unset, ScreenLinkResolver warm-up fails and deep
# links are silently unavailable.
FRONTEND_BASE_URL=http://pos-frontend:4000

POS_EVENTS_API_SECRET=your-secure-secret-here
POS_SECURITY_API_SECRET=your-secure-secret-here
# pos-order's functional currency (ADR-0067 R-2 Stage-A interim, removed by #2583): required, no default;
# pos-order refuses to start when it is unset or not an ISO 4217 code. Stamped on each register session at open.
POS_ORDER_FUNCTIONAL_CURRENCY=USD
# pos-tenant's internal registry endpoint (GET /internal/v1/tenants), polled by modules running
# pos.tenancy.registry.mode=REMOTE (ADR-0062 plan WS4-2). No Compose default: unset, the endpoint
# refuses every call (fail closed).
POS_TENANT_REGISTRY_API_SECRET=your-secure-secret-here
# pos-platform-sender's send API (X-Pos-Sender-Secret), shared with pos-marketing. No Compose
# default: unset, the sender refuses every send (fail closed).
POS_PLATFORM_SENDER_API_SECRET=your-secure-secret-here
# pos-platform-sender transport: 'log' (default) contacts nobody; 'aws' sends through SES and
# End User Messaging with the AWS default credential chain. Settings: pos-platform-sender/README.md.
POS_PLATFORM_SENDER_TRANSPORT=log
POS_PLATFORM_SENDER_EMAIL_FROM=
POS_PLATFORM_SENDER_EMAIL_CONFIGURATION_SET=
POS_PLATFORM_SENDER_SMS_ORIGINATION_IDENTITY=
POS_PLATFORM_SENDER_SMS_CONFIGURATION_SET=
POS_PLATFORM_SENDER_OUTCOMES_ENABLED=false
POS_PLATFORM_SENDER_OUTCOMES_QUEUE_URL=

# Ollama models. Chat + fallback default to CLOUD tags served by
# OLLAMA_CHAT_BASE_URL=https://ollama.com (require OLLAMA_API_KEY) — do NOT
# `ollama pull` these locally. The embedding model runs on the local Ollama
# container (OLLAMA_EMBEDDING_BASE_URL, default http://ollama:11434).
OLLAMA_CHAT_MODEL=deepseek-v4-flash:0731
# The RAG embedding column is 1024-dim bge-m3 (MCP_RAG_DIMENSION=1024, #1207), and ollama-init
# pulls this model: a 768-dim model such as nomic-embed-text would not match the column.
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_FALLBACK_MODEL=deepseek-v4-pro:0813

# Pre-LLM question tagging (ADR-0068). MCP_TAGGING_MODE: off | shadow | enforce. When it is not
# off and the endpoint is the local Ollama container (0.35+), ollama-init pulls
# OLLAMA_TAGGING_MODEL and pos-mcp-server tags with that same model (MCP_TAGGING_MODEL).
# Local candidates: nimble, tev1, tev1:0.8b (resident memory 0.8-9.5 GB). Measured on the
# GPU-less alpha t3.2xlarge (2026-10-01): tev1 has a 2,050-token context and rejects the
# 13-question request outright; warm, 7 questions took 5.2 s, so no local candidate meets the
# 800 ms budget there. See the bake-off procedure in
# pos-mcp-server/src/test/resources/eval/tagging-gate/README.md.
# Empty or unset means tev1:0.8b for both. The local tagging-model pull is skipped when
# MCP_TAGGING_MODE=off or MCP_TAGGING_BASE_URL does not target the local Ollama container.
OLLAMA_TAGGING_MODEL=tev1:0.8b
MCP_TAGGING_MODE=off
# enforce: the tags that act (comma-separated wire names; `<tag>:veto` lets the model only turn a
# heuristic true into false). Promotion order and evidence: ADR-0068 Changelog. The thresholds
# below are the 2026-10-01 bake-off values for jev-latest (hosted), en/fr-CA/es; 0.75 is the
# pre-bake-off default.
MCP_TAGGING_ENFORCED_TAGS=
MCP_TAGGING_THRESHOLD_SIMPLE_CHAT=0.80
MCP_TAGGING_THRESHOLD_FOLLOWS_PREVIOUS_TURN=0.70
MCP_TAGGING_THRESHOLD_NEEDS_WEB_SEARCH=0.85
MCP_TAGGING_THRESHOLD_ABOUT_INVENTORY=0.75
MCP_TAGGING_THRESHOLD_ABOUT_ORDERS=0.75
MCP_TAGGING_THRESHOLD_IMPLIES_DATE_WINDOW=0.70
MCP_TAGGING_THRESHOLD_ADMIN_ACCOUNT_QUESTION=0.60
MCP_TAGGING_THRESHOLD_COMPOUND_QUESTION=0.75
MCP_TAGGING_THRESHOLD_WORKFLOW_STATE=0.70
MCP_TAGGING_THRESHOLD_WORKFLOW_STATE_NON_IDLE=0.80
MCP_TAGGING_THRESHOLD_INTENT=0.50
MCP_TAGGING_THRESHOLD_COMPLEXITY=0.50
MCP_TAGGING_THRESHOLD_RISK=0.50
MCP_TAGGING_THRESHOLD_DOMAIN=0.50
MCP_TAGGING_THRESHOLD_ENTITY=0.85
# The tagging endpoint is never OLLAMA_CHAT_BASE_URL (ADR-0068 section 5). Default: the in-cell
# container. Hosted alternative (TypeSafe System One, same wire contract): allowed only where
# section 4 permits it -- an environment holding synthetic data, or one covered by a
# zero-retention data processing agreement recorded in the ADR Changelog. To use it:
#   MCP_TAGGING_BASE_URL=https://api.typesafe.ai
#   MCP_TAGGING_API_KEY=<secret, never committed>
#   OLLAMA_TAGGING_MODEL=jev-latest
#   MCP_TAGGING_KEEP_ALIVE=            (empty: the Ollama-only field is omitted from the request)
MCP_TAGGING_BASE_URL=http://ollama:11434
MCP_TAGGING_API_KEY=
# Also ask the one-Noul-per-entity questions (~18 KB body instead of ~8 KB); needs the scope
# graph on (MCP_SCOPE_GRAPH_MODE not off). Leave false for a small-context model; the bake-off
# decides per model (true on the hosted provider).
MCP_TAGGING_ENTITY_QUESTIONS=false
# Latency budget of the one tagging call per turn; not raised to fit a slow model (section 5).
MCP_TAGGING_TIMEOUT=800ms
# keep_alive sent with each tagging call so the local model stays resident between turns;
# matches OLLAMA_KEEP_ALIVE so a cold load after a quiet period does not time out the first
# turn. Empty omits the field (hosted provider).
MCP_TAGGING_KEEP_ALIVE=24h
# Scope graph (ADR-0069): off | shadow | enforce; MCP_SCOPE_GRAPH_ENFORCE lists the consumers
# that act under enforce (rag, tools, card, lookups), empty behaves as shadow.
MCP_SCOPE_GRAPH_MODE=off
MCP_SCOPE_GRAPH_ENFORCE=
# Per-actor chat turns per rate-limit window. The ADR-0068 gate sets send ~360 turns per language
# as one actor: set this high (e.g. 100000) for the duration of a bake-off, then put it back.
POS_NLTI_RATE_LIMIT_PER_SESSION=100
# Ollama server default keep_alive (requests that send none, i.e. the embedding calls).
OLLAMA_KEEP_ALIVE=24h

# Chat context window, sent to Ollama as num_ctx (#1683). application.yml already defaults this to
# 32768 for every profile, so leaving the line out entirely is fine -- you do NOT fall back to the
# backend's own window by omitting it. Set it only to override. Raise it if you add prompt layers,
# tool schemas, or RAG snippets; lower it to fit a backend that will not honour 32768.
#
# Do NOT write `OLLAMA_NUM_CTX=` (set but empty). Spring applies a ${VAR:default} only when the
# variable is ABSENT, not when it is empty, so an empty value reaches `int numCtx` as "" and the
# service fails to start. Same for OLLAMA_CHAT_TEMPERATURE into `double`. docker-compose masks
# this locally with `:-`; a systemd/ECS/k8s unit does not. Delete the line instead of blanking it.
OLLAMA_NUM_CTX=32768
# 0 = deterministic. The analytics gate is graded at n=1; sampling only adds run-to-run variance.
OLLAMA_CHAT_TEMPERATURE=0.0

# Gate 4 tiered model router (#1683). Dormant: with MCP_MODEL_SIMPLE blank, T2-simple and
# T2-complex are the same model, so enabling this only pays for a classification call whose
# outcome cannot change which model answers. Set MCP_MODEL_SIMPLE to a model that is measurably
# faster and cheaper than OLLAMA_CHAT_MODEL first, then set this to true. (gpt-oss:20b qualified
# next to gpt-oss:120b; next to deepseek-v4-flash:0731 it is the slower model, #1691.)
MCP_MODEL_TIERING_ENABLED=false
# Both tier models are read (docker-compose passes each through); blank = the default executor.
# Leave these commented out rather than blank -- a blank value is what makes the router a no-op.
# MCP_MODEL_SIMPLE=gpt-oss:20b
# MCP_MODEL_COMPLEX=

# Optional: MCP server web search
EXA_API_KEY=

# ── pos-supplier exchange-audit payload encryption (ADR-0050 §7) ────────────────────────
# REQUIRED. pos-supplier refuses to start without this unless the dev or test profile is
# active. Starting without it would mint a random key per JVM and make every stored payload
# permanently unreadable on the next restart -- reported afterwards as an authentication
# failure, i.e. as possible tampering, for data the deployment destroyed itself.
# Generate with:  openssl rand -base64 32
SUPPLIER_AUDIT_ENC_KEY=
# Recorded in every envelope so keys can be rotated. Leave as k1 unless rotating.
SUPPLIER_AUDIT_ENC_KEY_ID=k1
# Retired decrypt-only keys, keyId:base64 comma-separated. A key dropped from here before its
# payloads age out of the 400-day retention window takes them with it.
SUPPLIER_AUDIT_ENC_PREVIOUS_KEYS=

# ── pos-supplier vendor tax-registration number encryption (#2621) ──────────────────────
# REQUIRED, and a DIFFERENT key from SUPPLIER_AUDIT_ENC_KEY. pos-supplier seals every vendor
# tax-registration number with it (Security ruling on #2617, ruling 3) and refuses to start
# without it unless the dev or test profile is active. Provision it from the secret store;
# never commit a real value. Placeholder only below.
# Generate with:  openssl rand -base64 32
SUPPLIER_VENDOR_TAXID_ENC_KEY=
# Recorded in every envelope so keys can be rotated. Leave as k1 unless rotating.
SUPPLIER_VENDOR_TAXID_ENC_KEY_ID=k1
# Retired decrypt-only keys, keyId:base64 comma-separated. A key dropped from here while any
# number sealed under it is stored makes that number unreadable.
SUPPLIER_VENDOR_TAXID_ENC_PREVIOUS_KEYS=
