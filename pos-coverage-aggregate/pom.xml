			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.positivity</groupId>
			<artifactId>pos-price</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.positivity</groupId>
			<artifactId>pos-shop-manager</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.positivity</groupId>
