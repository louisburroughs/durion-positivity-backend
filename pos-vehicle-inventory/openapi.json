{
  "openapi": "3.1.0",
  "info": {
    "title": "Positivity Vehicle Inventory API",
    "description": "REST API for vehicle inventory management including vehicle CRUD, search, and care preferences (CAP:091)",
    "version": "v1",
    "contact": {
      "name": "Durion Platform Team"
    }
  },
  "servers": [
    {
      "url": "http://api-gateway.local/api/vehicle-inventory",
      "description": "API Gateway"
    }
  ],
  "tags": [
    {
      "name": "Vehicle Registry",
      "description": "Vehicle CRUD and management operations (CAP:091 Story #105)"
    },
    {
      "name": "Vehicle Search",
      "description": "Search and discover vehicles with ranking-based results (CAP:091 Story #103)"
    },
    {
      "name": "Vehicle Preferences",
      "description": "Manage vehicle care preferences with flexible JSONB schema (CAP:091 Story #102)"
    },
    {
      "name": "Vehicle API (Legacy)",
      "description": "Legacy vehicle CRUD endpoints for backward compatibility"
    }
  ],
  "paths": {
    "/v1/vehicles": {
      "post": {
        "tags": [
          "Vehicle Registry"
        ],
        "summary": "Create a new vehicle",
        "description": "Creates a new vehicle record with VIN validation and normalization. VIN must be globally unique across all active vehicles. Story #105 / Issue #105. Emits VEHICLE_CREATE event.",
        "operationId": "createVehicle",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVehicleRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Vehicle created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request - VIN format invalid, missing required fields, or duplicate VIN"
          },
          "409": {
            "description": "Conflict - VIN already exists for another active vehicle"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/vehicles/{vehicleId}": {
      "get": {
        "tags": [
          "Vehicle Registry"
        ],
        "summary": "Get vehicle by ID",
        "description": "Retrieves a vehicle by its unique UUID. Story #105.",
        "operationId": "getVehicle",
        "parameters": [
          {
            "name": "vehicleId",
            "in": "path",
            "description": "Vehicle UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vehicle found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleResponse"
                }
              }
            }
          },
          "404": {
            "description": "Vehicle not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "Vehicle Registry"
        ],
        "summary": "Update vehicle",
        "description": "Updates an existing vehicle's details. VIN cannot be changed. Story #105. Emits VEHICLE_UPDATE event.",
        "operationId": "updateVehicle",
        "parameters": [
          {
            "name": "vehicleId",
            "in": "path",
            "description": "Vehicle UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVehicleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vehicle updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "404": {
            "description": "Vehicle not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Vehicle Registry"
        ],
        "summary": "Delete vehicle",
        "description": "Soft-deletes (deactivates) a vehicle. Story #105.",
        "operationId": "deleteVehicle",
        "parameters": [
          {
            "name": "vehicleId",
            "in": "path",
            "description": "Vehicle UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Vehicle deleted successfully"
          },
          "404": {
            "description": "Vehicle not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/vehicles/vin/{vin}": {
      "get": {
        "tags": [
          "Vehicle Registry"
        ],
        "summary": "Get vehicle by VIN",
        "description": "Retrieves a vehicle by its VIN (normalized lookup). Story #105.",
        "operationId": "getVehicleByVin",
        "parameters": [
          {
            "name": "vin",
            "in": "path",
            "description": "Vehicle VIN (17 characters)",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-HJ-NPR-Z0-9]{17}$"
            },
            "example": "1HGCM82633A004352"
          }
        ],
        "responses": {
          "200": {
            "description": "Vehicle found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleResponse"
                }
              }
            }
          },
          "404": {
            "description": "Vehicle not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/vehicles/search": {
      "post": {
        "tags": [
          "Vehicle Search"
        ],
        "summary": "Search vehicles",
        "description": "Search for vehicles by VIN, license plate, unit number, or description. Results are ranked by relevance: exact match > prefix match > contains match. Story #103. Emits VEHICLE_SEARCH event.",
        "operationId": "searchVehicles",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchVehiclesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchVehiclesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid search query"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "get": {
        "tags": [
          "Vehicle Search"
        ],
        "summary": "Search vehicles (query parameter)",
        "description": "Alternative search endpoint using query parameters. Useful for browser-based queries. Story #103. Emits VEHICLE_SEARCH event.",
        "operationId": "searchVehiclesByQuery",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Search query (VIN, license plate, unit number, or description)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Result limit (default 25, max 50)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 25,
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "enableContains",
            "in": "query",
            "description": "Enable contains matching (default false)",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchVehiclesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid search query"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/vehicles/{vehicleId}/preferences": {
      "get": {
        "tags": [
          "Vehicle Preferences"
        ],
        "summary": "Get vehicle care preferences",
        "description": "Retrieves the care preferences for a vehicle. Returns 404 if no preferences exist. Story #102.",
        "operationId": "getPreferences",
        "parameters": [
          {
            "name": "vehicleId",
            "in": "path",
            "description": "Vehicle UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Preferences found and returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleCarePreference"
                }
              }
            }
          },
          "404": {
            "description": "No preferences found for this vehicle"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "Vehicle Preferences"
        ],
        "summary": "Create or update vehicle care preferences",
        "description": "Upserts preferences for a vehicle. If preferences exist, replaces them entirely. Use PATCH for partial updates. Story #102. Emits VEHICLE_PREFERENCES_UPSERT event.",
        "operationId": "upsertPreferences",
        "parameters": [
          {
            "name": "vehicleId",
            "in": "path",
            "description": "Vehicle UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferencesUpsertDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preferences updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleCarePreference"
                }
              }
            }
          },
          "201": {
            "description": "Preferences created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleCarePreference"
                }
              }
            }
          },
          "400": {
            "description": "Invalid preference data"
          },
          "404": {
            "description": "Vehicle not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "patch": {
        "tags": [
          "Vehicle Preferences"
        ],
        "summary": "Partially update vehicle care preferences",
        "description": "Merges provided preference fields into existing preferences without replacing the entire map. Story #102. Emits VEHICLE_PREFERENCES_MERGE event.",
        "operationId": "mergePreferences",
        "parameters": [
          {
            "name": "vehicleId",
            "in": "path",
            "description": "Vehicle UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferencesMergeDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preferences merged successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleCarePreference"
                }
              }
            }
          },
          "404": {
            "description": "No existing preferences to merge into"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Vehicle Preferences"
        ],
        "summary": "Delete vehicle care preferences",
        "description": "Removes all preferences for a vehicle. Story #102. Emits VEHICLE_PREFERENCES_DELETE event.",
        "operationId": "deletePreferences",
        "parameters": [
          {
            "name": "vehicleId",
            "in": "path",
            "description": "Vehicle UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Preferences deleted successfully"
          },
          "404": {
            "description": "No preferences found to delete"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateVehicleRequest": {
        "type": "object",
        "description": "Request DTO for creating a vehicle - CAP:091 Story #105",
        "required": [
          "accountId",
          "vin",
          "unitNumber",
          "description"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid",
            "description": "Account ID that owns this vehicle"
          },
          "vin": {
            "type": "string",
            "pattern": "^[A-HJ-NPR-Z0-9]{17}$",
            "description": "Vehicle Identification Number (17 characters, excludes I, O, Q)"
          },
          "unitNumber": {
            "type": "string",
            "description": "Internal unit number for the vehicle"
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of the vehicle"
          },
          "licensePlate": {
            "type": "string",
            "description": "License plate number"
          },
          "licensePlateJurisdiction": {
            "type": "string",
            "description": "State/province of license plate registration"
          },
          "year": {
            "type": "integer",
            "description": "Vehicle year"
          },
          "make": {
            "type": "string",
            "description": "Vehicle make/manufacturer"
          },
          "model": {
            "type": "string",
            "description": "Vehicle model"
          },
          "trim": {
            "type": "string",
            "description": "Vehicle trim level"
          }
        }
      },
      "VehicleResponse": {
        "type": "object",
        "description": "Response DTO for vehicle operations - CAP:091",
        "properties": {
          "vehicleId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique vehicle identifier (UUID v7)"
          },
          "accountId": {
            "type": "string",
            "format": "uuid",
            "description": "Account ID that owns this vehicle"
          },
          "vin": {
            "type": "string",
            "description": "Original VIN as provided"
          },
          "vinNormalized": {
            "type": "string",
            "description": "Normalized VIN (uppercase, no spaces) for uniqueness checks"
          },
          "unitNumber": {
            "type": "string",
            "description": "Internal unit number"
          },
          "description": {
            "type": "string",
            "description": "Human-readable description"
          },
          "licensePlate": {
            "type": "string",
            "description": "License plate number"
          },
          "licensePlateJurisdiction": {
            "type": "string",
            "description": "State/province of license plate"
          },
          "year": {
            "type": "integer",
            "description": "Vehicle year"
          },
          "make": {
            "type": "string",
            "description": "Vehicle make"
          },
          "model": {
            "type": "string",
            "description": "Vehicle model"
          },
          "trim": {
            "type": "string",
            "description": "Vehicle trim"
          },
          "isActive": {
            "type": "boolean",
            "description": "Whether the vehicle is active (not soft-deleted)"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "Optimistic locking version"
          }
        }
      },
      "SearchVehiclesRequest": {
        "type": "object",
        "description": "Request DTO for searching vehicles - CAP:091 Story #103",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query (VIN, license plate, unit number, or description)"
          },
          "limit": {
            "type": "integer",
            "default": 25,
            "minimum": 1,
            "maximum": 50,
            "description": "Result limit (default 25, max 50)"
          },
          "cursor": {
            "type": "string",
            "description": "Pagination cursor (reserved for future use)"
          },
          "enableContainsMatching": {
            "type": "boolean",
            "default": false,
            "description": "Enable contains matching (default false for strict matching)"
          }
        }
      },
      "SearchVehiclesResponse": {
        "type": "object",
        "description": "Search results response - CAP:091 Story #103",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VehicleSummary"
            },
            "description": "List of matching vehicles"
          },
          "totalCount": {
            "type": "integer",
            "description": "Total number of results"
          },
          "hasMore": {
            "type": "boolean",
            "description": "Whether more results are available"
          },
          "query": {
            "type": "string",
            "description": "Original search query"
          }
        }
      },
      "VehicleSummary": {
        "type": "object",
        "description": "Vehicle summary for search results - CAP:091 Story #103",
        "properties": {
          "vehicleId": {
            "type": "string",
            "format": "uuid",
            "description": "Vehicle UUID"
          },
          "vin": {
            "type": "string",
            "description": "Vehicle VIN"
          },
          "unitNumber": {
            "type": "string",
            "description": "Internal unit number"
          },
          "licensePlate": {
            "type": "string",
            "description": "License plate number"
          },
          "description": {
            "type": "string",
            "description": "Vehicle description"
          },
          "year": {
            "type": "integer",
            "description": "Vehicle year"
          },
          "make": {
            "type": "string",
            "description": "Vehicle make"
          },
          "model": {
            "type": "string",
            "description": "Vehicle model"
          }
        }
      },
      "VehicleCarePreference": {
        "type": "object",
        "description": "Vehicle care preferences entity - CAP:091 Story #102. Stores structured and unstructured vehicle care preferences using JSONB.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Preference record UUID (UUID v7)"
          },
          "vehicleId": {
            "type": "string",
            "format": "uuid",
            "description": "Vehicle UUID"
          },
          "preferences": {
            "type": "object",
            "additionalProperties": true,
            "description": "Flexible JSONB preference map (supports arbitrary key-value pairs)"
          },
          "serviceNotes": {
            "type": "string",
            "description": "Free-text service notes"
          },
          "createdByUserId": {
            "type": "string",
            "format": "uuid",
            "description": "User who created the preferences"
          },
          "updatedByUserId": {
            "type": "string",
            "format": "uuid",
            "description": "User who last updated the preferences"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "Optimistic locking version"
          }
        }
      },
      "PreferencesUpsertDto": {
        "type": "object",
        "description": "DTO for upserting vehicle care preferences",
        "required": [
          "preferences",
          "createdByUserId",
          "updatedByUserId"
        ],
        "properties": {
          "preferences": {
            "type": "object",
            "additionalProperties": true,
            "description": "Complete preference map (replaces existing preferences)"
          },
          "serviceNotes": {
            "type": "string",
            "description": "Service notes"
          },
          "createdByUserId": {
            "type": "string",
            "format": "uuid",
            "description": "User creating the preferences (for new records)"
          },
          "updatedByUserId": {
            "type": "string",
            "format": "uuid",
            "description": "User updating the preferences"
          }
        }
      },
      "PreferencesMergeDto": {
        "type": "object",
        "description": "DTO for merging vehicle care preferences",
        "required": [
          "partialPreferences",
          "updatedByUserId"
        ],
        "properties": {
          "partialPreferences": {
            "type": "object",
            "additionalProperties": true,
            "description": "Partial preference map to merge (does not replace existing keys)"
          },
          "updatedByUserId": {
            "type": "string",
            "format": "uuid",
            "description": "User updating the preferences"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer token authentication"
      }
    }
  }
}