{
  "openapi": "3.1.0",
  "info": {
    "title": "Positivity Location API",
    "description": "REST API for managing locations, bays, mobile units, and their hierarchical relationships",
    "version": "v1",
    "contact": {
      "name": "Durion Platform Team"
    }
  },
  "servers": [
    {
      "url": "http://api-gateway.local/api/location",
      "description": "API Gateway"
    }
  ],
  "tags": [
    {
      "name": "Location API",
      "description": "Operations related to locations and their relationships"
    },
    {
      "name": "Bay API",
      "description": "Operations for managing bays within locations"
    },
    {
      "name": "Mobile Unit API",
      "description": "Operations for managing mobile units within locations"
    }
  ],
  "paths": {
    "/v1/locations": {
      "get": {
        "tags": [
          "Location API"
        ],
        "summary": "Get all locations",
        "description": "Retrieve a list of all locations.",
        "operationId": "getAllLocations",
        "responses": {
          "200": {
            "description": "List of locations returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Location"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Location API"
        ],
        "summary": "Create a new location",
        "description": "Add a new location to the system.",
        "operationId": "createLocation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Location"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Location created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Location"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/locations/{locationId}": {
      "get": {
        "tags": [
          "Location API"
        ],
        "summary": "Get location by ID",
        "description": "Retrieve a location by its unique ID.",
        "operationId": "getLocationById",
        "parameters": [
          {
            "name": "locationId",
            "in": "path",
            "description": "ID of the location to retrieve",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "018e1c9f-6b5a-7890-abcd-1234567890ab"
          }
        ],
        "responses": {
          "200": {
            "description": "Location found and returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Location"
                }
              }
            }
          },
          "404": {
            "description": "Location not found."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "Location API"
        ],
        "summary": "Update an existing location",
        "description": "Update the details of an existing location.",
        "operationId": "updateLocation",
        "parameters": [
          {
            "name": "locationId",
            "in": "path",
            "description": "ID of the location to update",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "018e1c9f-6b5a-7890-abcd-1234567890ab"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Location"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Location updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Location"
                }
              }
            }
          },
          "404": {
            "description": "Location not found."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Location API"
        ],
        "summary": "Delete a location",
        "description": "Delete a location by its unique ID.",
        "operationId": "deleteLocation",
        "parameters": [
          {
            "name": "locationId",
            "in": "path",
            "description": "ID of the location to delete",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "018e1c9f-6b5a-7890-abcd-1234567890ab"
          }
        ],
        "responses": {
          "204": {
            "description": "Location deleted successfully."
          },
          "404": {
            "description": "Location not found."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/locations/{childId}/parents/{parentId}": {
      "post": {
        "tags": [
          "Location API"
        ],
        "summary": "Add a parent to a location",
        "description": "Add a parent relationship to a location.",
        "operationId": "addParent",
        "parameters": [
          {
            "name": "childId",
            "in": "path",
            "description": "ID of the child location",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "018e1c9f-6b5a-7890-abcd-1234567890ab"
          },
          {
            "name": "parentId",
            "in": "path",
            "description": "ID of the parent location",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "018e1c9f-0000-7890-abcd-1234567890ab"
          },
          {
            "name": "parentType",
            "in": "query",
            "description": "Type of the parent relationship",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "HOME_OFFICE",
                "HEADQUARTERS",
                "REGION",
                "DISTRICT",
                "BILLING"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Parent relationship added successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocationParent"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/locations/parents": {
      "get": {
        "tags": [
