  "components": {
    "schemas": {
      "Location": {
        "type": "object",
        "description": "Location entity representing a physical location",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the location (UUID v7)"
          },
          "name": {
            "type": "string",
            "description": "Name of the location"
          },
          "addressLine1": {
            "type": "string",
            "description": "First line of the address"
          },
          "addressLine2": {
            "type": "string",
            "description": "Second line of the address"
          },
          "city": {
            "type": "string",
            "description": "City"
          },
          "state": {
            "type": "string",
            "description": "State or province"
          },
          "postalCode": {
            "type": "string",
            "description": "Postal or ZIP code"
          },
          "country": {
            "type": "string",
            "description": "Country"
          },
          "mailingAddress": {
            "type": "string",
            "description": "Mailing address if different from physical"
          },
          "responsiblePersonId": {
            "type": "string",
            "format": "uuid",
            "description": "People-contact person identifier of the responsible person"
          }
        }
      },
      "LocationParent": {
        "type": "object",
        "description": "Parent-child relationship between locations",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the relationship (UUID v7)"
          },
          "parentType": {
            "type": "string",
            "description": "Type of parent relationship",
            "enum": [
              "HOME_OFFICE",
              "HEADQUARTERS",
              "REGION",
              "DISTRICT",
              "BILLING"
            ]
          }
        }
      },
      "PersonDTO": {
        "type": "object",
        "description": "Person data transfer object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "People-contact person identifier"
          },
          "firstName": {
            "type": "string",
            "description": "First name"
          },
          "lastName": {
            "type": "string",
            "description": "Last name"
          },
          "primaryEmail": {
            "type": "string",
            "format": "email",
            "description": "Primary email address"
          },
          "secondaryEmail": {
            "type": "string",
            "format": "email",
            "description": "Secondary email address"
          },
          "phoneNumbers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of phone numbers"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer token authentication"
      }
    }
  }
}
