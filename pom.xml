				<scope>test</scope>
			</dependency>

			<!--
				CVE mitigations: force patched versions of vulnerable transitive dependencies
				that Spring Cloud / Netflix Eureka / Archaius pull in.
				commons-configuration-1.10 (CVE-2025-46392) has no 1.x fix release and is
