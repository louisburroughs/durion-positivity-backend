{
    "openapi": "3.1.0",
    "info": {
        "title": "Positivity Product API",
        "description": "API documentation for the Product service, accessible via the API Gateway.",
        "contact": {
            "name": "Durion Team",
            "email": "louis.burroughs@gmail.com"
        },
        "version": "v1"
    },
    "servers": [
        {
            "url": "http://api-gateway.local/api/catalog",
            "description": "API Gateway"
        }
    ],
    "tags": [
        {
            "name": "Catalog API",
            "description": "API for managing catalog items"
        }
    ],
    "paths": {
        "/v1/products/{type}/{catalogId}": {
            "put": {
                "tags": [
                    "Catalog API"
                ],
                "summary": "Update an existing catalog item",
                "description": "Updates an existing product, service, or non-inventory product in the catalog.",
                "operationId": "updateCatalogItem",
                "parameters": [
                    {
                        "name": "type",
                        "in": "path",
                        "description": "Type of catalog item (product, service, noninventory)",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "catalogId",
                        "in": "path",
                        "description": "ID of the catalog item to update",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CatalogItem"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Catalog item updated successfully",
                        "content": {
                            "*/*": {
                                "schema": {}
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid item type or request body",
                        "content": {
                            "*/*": {
                                "schema": {}
                            }
                        }
                    },
                    "404": {
                        "description": "Catalog item not found",
                        "content": {
                            "*/*": {
                                "schema": {}
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Catalog API"
                ],
                "summary": "Delete a catalog item",
                "description": "Deletes a product, service, or non-inventory product from the catalog by its ID.",
                "operationId": "deleteCatalogItem",
                "parameters": [
                    {
                        "name": "type",
                        "in": "path",
                        "description": "Type of catalog item (product, service, noninventory)",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "catalogId",
                        "in": "path",
                        "description": "ID of the catalog item to delete",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Catalog item deleted successfully"
                    },
                    "400": {
                        "description": "Invalid item type"
                    },
                    "404": {
                        "description": "Catalog item not found"
                    }
                }
            }
        },
        "/v1/products/catalog/{catalogId}": {
            "get": {
                "tags": [
                    "Catalog API"
                ],
                "summary": "Get a catalog by ID",
                "description": "Retrieves a specific catalog by its unique ID.",
                "operationId": "getCatalogById",
                "parameters": [
                    {
                        "name": "catalogId",
                        "in": "path",
                        "description": "ID of the catalog to be obtained",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved catalog",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CatalogEntity"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Catalog not found",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/CatalogEntity"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Catalog API"
                ],
                "summary": "Update an existing catalog",
                "description": "Updates an existing catalog.",
                "operationId": "updateCatalog",
                "parameters": [
                    {
                        "name": "catalogId",
                        "in": "path",
                        "description": "ID of the catalog to update",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "description": "Updated catalog object",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CatalogEntity"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "400": {
                        "description": "Invalid request body",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/CatalogEntity"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "Catalog updated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CatalogEntity"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Catalog not found",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/CatalogEntity"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Catalog API"
                ],
                "summary": "Delete a catalog",
                "description": "Deletes a catalog by its ID.",
                "operationId": "deleteCatalog",
                "parameters": [
                    {
                        "name": "catalogId",
                        "in": "path",
                        "description": "ID of the catalog to delete",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Catalog deleted successfully"
                    },
                    "404": {
                        "description": "Catalog not found"
                    }
                }
            }
        },
        "/v1/products/{type}": {
            "post": {
                "tags": [
                    "Catalog API"
                ],
                "summary": "Add a new catalog item",
                "description": "Adds a new product, service, or non-inventory product to the catalog.",
                "operationId": "addCatalogItem",
                "parameters": [
                    {
                        "name": "type",
                        "in": "path",
                        "description": "Type of catalog item (product, service, noninventory)",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CatalogItem"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Catalog item created successfully",
                        "content": {
                            "*/*": {
                                "schema": {}
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid item type or request body",
                        "content": {
                            "*/*": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/v1/products/catalog": {
            "post": {
                "tags": [
                    "Catalog API"
                ],
                "summary": "Add a new catalog",
                "description": "Adds a new catalog.",
                "operationId": "addCatalog",
                "requestBody": {
                    "description": "Catalog object to be added",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CatalogEntity"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "400": {
                        "description": "Invalid request body",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/CatalogEntity"
                                }
                            }
                        }
                    },
                    "201": {
                        "description": "Catalog created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CatalogEntity"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/products/{productId}": {
            "get": {
                "tags": [
                    "Catalog API"
                ],
                "summary": "Get a product by ID",
                "description": "Retrieves a specific product by its unique ID.",
                "operationId": "getProductById",
                "parameters": [
                    {
                        "name": "productId",
                        "in": "path",
                        "description": "ID of the product to be obtained",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved product",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductEntity"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Product not found",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductEntity"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/products/substitutes/{productId}": {
            "get": {
                "tags": [
                    "Catalog API"
                ],
                "summary": "Get substitute parts",
                "description": "Returns list of substitute parts for a given productId.",
                "operationId": "getPartSubstitutes",
                "parameters": [
                    {
                        "name": "productId",
                        "in": "path",
                        "description": "ID of the product",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "501": {
                        "description": "Not implemented",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ProductEntity"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/products/service/{serviceId}": {
            "get": {
                "tags": [
                    "Catalog API"
                ],
                "summary": "Get a service by ID",
                "description": "Retrieves a specific service by its unique ID.",
                "operationId": "getServiceById",
                "parameters": [
                    {
                        "name": "serviceId",
                        "in": "path",
                        "description": "ID of the service to be obtained",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved service",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ServiceEntity"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Service not found",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ServiceEntity"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/products/service/name/{name}": {
            "get": {
                "tags": [
                    "Catalog API"
                ],
                "summary": "Get services by name",
                "description": "Retrieves a list of services matching the given name.",
                "operationId": "getServiceByName",
                "parameters": [
                    {
                        "name": "name",
                        "in": "path",
                        "description": "Name of the services to be obtained",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved services",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ServiceEntity"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/products/product/{productId}": {
            "get": {
                "tags": [
                    "Catalog API"
                ],
                "summary": "Get product details with pricing and availability",
                "description": "Retrieves a consolidated view of product information including catalog data, location-specific pricing, and availability. Implements graceful degradation: returns partial data with status indicators if non-critical services are unavailable.",
                "operationId": "getProductDetailView",
                "parameters": [
                    {
                        "name": "productId",
                        "in": "path",
                        "description": "ID of the product",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "location_id",
                        "in": "query",
                        "description": "Location/store ID for location-specific data",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "400": {
                        "description": "Invalid location ID",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductDetailView"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Product not found",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductDetailView"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Unexpected server error while retrieving product details",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductDetailView"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "Successfully retrieved product details (may be partial if some services unavailable)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductDetailView"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/products/noninventory/{productId}": {
            "get": {
                "tags": [
                    "Catalog API"
                ],
                "summary": "Get a non-inventory product by ID",
                "description": "Retrieves a specific non-inventory product by its unique ID.",
                "operationId": "getNonInventoryProductById",
                "parameters": [
                    {
                        "name": "productId",
                        "in": "path",
                        "description": "ID of the non-inventory product to be obtained",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved non-inventory product",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NonInventoryProductEntity"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Non-inventory product not found",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/NonInventoryProductEntity"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/products/noninventory/name/{name}": {
            "get": {
                "tags": [
                    "Catalog API"
                ],
                "summary": "Get non-inventory products by name",
                "description": "Retrieves a list of non-inventory products matching the given name.",
                "operationId": "getNonInventoryProductByName",
                "parameters": [
                    {
                        "name": "name",
                        "in": "path",
                        "description": "Name of the non-inventory products to be obtained",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved non-inventory products",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NonInventoryProductEntity"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/products/name/{name}": {
            "get": {
                "tags": [
                    "Catalog API"
                ],
                "summary": "Get products by name",
                "description": "Retrieves a list of products matching the given name.",
                "operationId": "getProductByName",
                "parameters": [
                    {
                        "name": "name",
                        "in": "path",
                        "description": "Name of the products to be obtained",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved products",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductEntity"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/products/catalog/name/{name}": {
            "get": {
                "tags": [
                    "Catalog API"
                ],
                "summary": "Get catalogs by name",
                "description": "Retrieves a list of catalogs matching the given name.",
                "operationId": "getCatalogByName",
                "parameters": [
                    {
                        "name": "name",
                        "in": "path",
                        "description": "Name of the catalogs to be obtained",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully retrieved catalogs",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CatalogEntity"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CatalogItem": {
                "type": "object",
                "properties": {
                    "shortDescription": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "longDescription": {
                        "type": "string"
                    }
                }
            },
            "CatalogEntity": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "products": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ProductEntity"
                        }
                    },
                    "services": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ServiceEntity"
                        }
                    },
                    "nonInventoryProducts": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/NonInventoryProductEntity"
                        }
                    }
                }
            },
            "Category": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string"
                    }
                }
            },
            "DimensionEntity": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "dimensionType": {
                        "type": "string",
                        "enum": [
                            "LENGTH",
                            "WIDTH",
                            "HEIGHT",
                            "WEIGHT",
                            "VOLUME",
                            "AREA",
                            "DIAMETER",
                            "CIRCUMFERENCE",
                            "RADIUS",
                            "TEMPERATURE",
                            "TIME",
                            "SPEED",
                            "PRESSURE",
                            "FORCE",
                            "ENERGY",
                            "POWER",
                            "FREQUENCY",
                            "ANGLE",
                            "DATA_SIZE",
                            "CURRENT",
                            "VOLTAGE",
                            "RESISTANCE"
                        ]
                    },
                    "description": {
                        "type": "string"
                    },
                    "unitOfMeasure": {
                        "type": "string"
                    },
                    "dimensionValue": {
                        "type": "number",
                        "format": "double"
                    }
                }
            },
            "NonInventoryProductEntity": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string"
                    },
                    "longDescription": {
                        "type": "string"
                    },
                    "shortDescription": {
                        "type": "string"
                    }
                }
            },
            "ProductEntity": {
                "type": "object",
                "description": "Represents a product in the catalog",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "description": "Unique identifier of the product",
                        "example": "018e1c9f-6b5a-7890-abcd-1234567890ab"
                    },
                    "name": {
                        "type": "string",
                        "description": "Name of the product",
                        "example": "Heavy Duty Wrench"
                    },
                    "shortDescription": {
                        "type": "string",
                        "description": "Short description of the product",
                        "example": "A versatile wrench for heavy-duty applications."
                    },
                    "longDescription": {
                        "type": "string",
                        "description": "Detailed description of the product",
                        "example": "This heavy-duty wrench is made from hardened steel..."
                    },
                    "images": {
                        "type": "array",
                        "description": "List of image URLs for the product",
                        "items": {
                            "type": "string"
                        }
                    },
                    "manufacturerPartNumber": {
                        "type": "string",
                        "description": "Manufacturer's part number",
                        "example": "HDW-001"
                    },
                    "manufacturerId": {
                        "type": "string",
                        "description": "Identifier for the manufacturer",
                        "example": "MAN-123"
                    },
                    "manufacturerName": {
                        "type": "string",
                        "description": "Name of the manufacturer",
                        "example": "Acme Tools"
                    },
                    "manufacturerWarranty": {
                        "type": "string",
                        "description": "Manufacturer's warranty information",
                        "example": 1
                    },
                    "manufacturerBrand": {
                        "type": "string",
                        "description": "Brand of the manufacturer",
                        "example": "AcmePro"
                    },
                    "countryOfOrigin": {
                        "type": "string",
                        "description": "Country of origin for the product",
                        "example": "USA"
                    },
                    "sku": {
                        "type": "string",
                        "description": "Stock Keeping Unit (SKU)",
                        "example": "SKU12345"
                    },
                    "productCode": {
                        "type": "string",
                        "description": "Product code (e.g., UPC, EAN)",
                        "example": "0123456789012"
                    },
                    "productCodeType": {
                        "type": "string",
                        "description": "Type of the product code (e.g., UPC, EAN)",
                        "enum": [
                            "UPC",
                            "EAN"
                        ]
                    },
                    "category": {
                        "$ref": "#/components/schemas/Category",
                        "description": "Category of the product"
                    },
                    "subcategory": {
                        "$ref": "#/components/schemas/Subcategory",
                        "description": "Subcategory of the product"
                    },
                    "type": {
                        "type": "string",
                        "description": "Type of the product (e.g., physical, digital)",
                        "example": "Physical"
                    },
                    "dimensions": {
                        "type": "array",
                        "description": "List of dimensions for the product",
                        "items": {
                            "$ref": "#/components/schemas/DimensionEntity"
                        }
                    },
                    "material": {
                        "type": "string",
                        "description": "Material of the product",
                        "example": "Steel"
                    },
                    "color": {
                        "type": "string",
                        "description": "Color of the product",
                        "example": "Red"
                    },
                    "warranty": {
                        "type": "string",
                        "description": "Warranty information for the product",
                        "example": 2
                    },
                    "specifications": {
                        "type": "string",
                        "description": "Detailed specifications of the product",
                        "example": {
                            "weight": "5kg",
                            "length": "30cm"
                        }
                    }
                }
            },
            "ServiceEntity": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string"
                    },
                    "longDescription": {
                        "type": "string"
                    },
                    "shortDescription": {
                        "type": "string"
                    }
                }
