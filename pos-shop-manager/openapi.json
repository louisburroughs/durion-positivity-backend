  "components": {
    "schemas": {
      "PersonDTO": {
        "type": "object",
        "description": "Person details for a technician",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Person ID"
          },
          "firstName": {
            "type": "string",
            "description": "First name"
          },
          "lastName": {
            "type": "string",
            "description": "Last name"
          },
          "primaryEmail": {
            "type": "string",
            "format": "email",
            "description": "Primary email address"
          },
          "secondaryEmail": {
            "type": "string",
            "format": "email",
            "description": "Secondary email address"
          },
          "phoneNumbers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of phone numbers"
          },
          "username": {
            "type": "string",
            "description": "Username"
          }
        }
      },
      "ServiceEntityDTO": {
        "type": "object",
        "description": "Shop service details from catalog",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Service ID"
          },
          "name": {
            "type": "string",
            "description": "Service name"
          },
          "description": {
            "type": "string",
            "description": "Service description"
          }
        }
      },
      "AppointmentCreateRequest": {
        "type": "object",
        "description": "Request to create an appointment from an Estimate or Work Order. Includes idempotency support via clientRequestId. Supports soft conflict override with reason for audit trail.",
        "required": [
          "sourceType",
          "sourceId",
          "facilityId",
          "scheduledStartDateTime",
          "scheduledEndDateTime"
        ],
        "properties": {
          "sourceType": {
            "type": "string",
            "enum": [
              "ESTIMATE",
              "WORKORDER"
            ],
            "description": "Source type (ESTIMATE or WORKORDER)"
          },
          "sourceId": {
            "type": "string",
            "description": "Estimate ID or Work Order ID (opaque string)"
          },
          "facilityId": {
            "type": "string",
            "description": "Facility identifier (opaque string)"
          },
          "scheduledStartDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Scheduled start date/time (ISO-8601 with offset)"
          },
          "scheduledEndDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Scheduled end date/time (ISO-8601 with offset)"
          },
          "clientRequestId": {
            "type": "string",
            "format": "uuid",
            "description": "UUID for idempotency (optional but recommended)"
          },
          "overrideSoftConflicts": {
            "type": "boolean",
            "default": false,
            "description": "Override soft conflicts (default false)"
          },
          "overrideReason": {
            "type": "string",
            "description": "Reason for override (required when overrideSoftConflicts=true)"
          }
        }
      },
      "AppointmentResponse": {
        "type": "object",
        "description": "Response for successful appointment creation or retrieval. Includes appointment details, facility timezone for display, and optional notification outcome. Timestamps include facility timezone offset for scheduled times; createdAt/lastUpdatedAt are in UTC (Z).",
        "properties": {
          "appointmentId": {
            "type": "string",
            "description": "Appointment identifier (opaque string)"
          },
          "appointmentStatus": {
            "type": "string",
            "description": "Appointment status (SCHEDULED, CANCELLED, etc.)"
          },
          "scheduledStartDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Scheduled start date/time (ISO-8601 with facility timezone offset)"
          },
          "scheduledEndDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Scheduled end date/time (ISO-8601 with facility timezone offset)"
          },
          "facilityId": {
            "type": "string",
            "description": "Facility identifier"
          },
          "facilityTimeZoneId": {
            "type": "string",
            "description": "IANA timezone ID (e.g., America/New_York)"
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "ESTIMATE",
              "WORKORDER"
            ],
            "description": "Source type (ESTIMATE or WORKORDER)"
          },
          "sourceId": {
            "type": "string",
            "description": "Estimate ID or Work Order ID"
          },
          "notificationOutcomeSummary": {
            "type": "string",
            "description": "Optional notification outcome (e.g., 'Email sent to customer')"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Created timestamp (ISO-8601 UTC/Z)"
          },
          "lastUpdatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Last updated timestamp (ISO-8601 UTC/Z)"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer token authentication"
      }
    }
  }
}