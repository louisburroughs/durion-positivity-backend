    "/v1/shop-manager/appointments": {
      "post": {
        "tags": [
          "Appointments"
        ],
        "summary": "Create appointment",
        "description": "Create a new appointment from an Estimate or Work Order. Idempotent via Idempotency-Key header. Supports soft conflict override with reason for audit trail. Emits SHOP_APPOINTMENT_CREATE event.",
        "operationId": "createAppointment",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Idempotency key for safe retries (UUID recommended)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "description": "Correlation ID for request tracing",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppointmentCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Appointment created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentResponse"
                }
              }
            }
          },
          "409": {
            "description": "Scheduling conflict detected"
          },
          "501": {
            "description": "Not implemented"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
