{
  "openapi": "3.1.0",
  "info": {
    "title": "Positivity Shop Manager API",
    "description": "REST API for shop management operations including bays, mobile units, appointments, schedules, and workorder operational context",
    "version": "v1",
    "contact": {
      "name": "Durion Platform Team"
    }
  },
  "servers": [
    {
      "url": "http://api-gateway.local/api/shop-manager",
      "description": "API Gateway"
    }
  ],
  "tags": [
    {
      "name": "Shop Bays",
      "description": "Bay management within shop locations"
    },
    {
      "name": "Shop Mobile Units",
      "description": "Mobile unit management within shop locations"
    },
    {
      "name": "Shop Management",
      "description": "Shop management, technicians, and services"
    },
    {
      "name": "Appointments",
      "description": "Appointment creation and retrieval with idempotency support"
    },
    {
      "name": "Workorder Operational Context",
      "description": "Read-only operational context view for workorders"
    },
    {
      "name": "Schedules",
      "description": "Read-only schedule view operations"
    }
  ],
